# Response headers for Cloudflare static assets
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML is always revalidated so edits show up straight away
/
  Cache-Control: public, max-age=0, must-revalidate

/en/
  Cache-Control: public, max-age=0, must-revalidate

# CSS and JS are revalidated so edits show up straight away
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Images are cached for a day
/assets/img/*
  Cache-Control: public, max-age=86400

# Browsers use HTTPS for gulf.is from the first visit on
https://gulf.is/*
  Strict-Transport-Security: max-age=31536000
